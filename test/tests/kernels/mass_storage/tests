[Tests]
  design = 'OrcaFullySaturatedSinglePhaseMassTimeDerivativeKernel.md'
  issues = '#N1'
  [storage_rate]
    type = CSVDiff
    input = 'mass_storage.i'
    csvdiff = 'mass_storage_out.csv'
    rel_err = 1e-8
    requirement = 'OrcaFullySaturatedSinglePhaseMassTimeDerivativeKernel shall assemble the storage '
                  'term as (1/M) dp/dt, dividing by the Biot modulus held in biot_modulus_qp, so that '
                  'a constant volumetric source q drives the closed-form response p(t) = M q t.'
  []
  [alpha_unphysical]
    type = CSVDiff
    input = 'mass_storage.i'
    cli_args = 'biot_coefficient=1e-12 biot_modulus_exact=5.1832204827e12 '
               'Outputs/file_base=alpha_unphysical_out'
    csvdiff = 'alpha_unphysical_out.csv'
    rel_err = 1e-8
    prereq = 'storage_rate'
    requirement = 'OrcaFullySaturatedSinglePhaseMassTimeDerivativeKernel shall reproduce the closed-form '
                  'response at a Biot coefficient below the porosity, where the 21x larger Biot modulus '
                  'produces a correspondingly larger pressure response for the same source.'
  []
[]
