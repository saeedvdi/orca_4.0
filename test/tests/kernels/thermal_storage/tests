[Tests]
  design = 'OrcaFullySaturatedSinglePhaseMassTimeDerivativeKernel.md'
  issues = '#N1'
  [thermal_rate]
    type = CSVDiff
    input = 'thermal_storage.i'
    csvdiff = 'thermal_storage_out.csv'
    rel_err = 1e-8
    requirement = 'OrcaFullySaturatedSinglePhaseMassTimeDerivativeKernel shall assemble the thermal '
                  'storage term as -alpha_T dT/dt, so that heating a sealed sample at a constant rate r '
                  'drives the closed-form pressure response p(t) = M alpha_T r t, with the sign that '
                  'pressurises rather than depressurises on heating.'
  []
  [alpha_eff_user]
    type = CSVDiff
    input = 'thermal_storage.i'
    # A value deliberately different from the computed 1.4586e-5, so this case
    # fails if the user model silently falls through to the computed formula.
    cli_args = 'Materials/rockTH/effective_thermal_expansion_model=user '
               'Materials/rockTH/effective_thermal_expansion_coeff=2.0e-5 '
               'alpha_eff_exact=2.0e-5 Outputs/file_base=alpha_eff_user_out'
    csvdiff = 'alpha_eff_user_out.csv'
    rel_err = 1e-8
    prereq = 'thermal_rate'
    requirement = 'OrcaTHMaterial shall use effective_thermal_expansion_coeff verbatim when '
                  'effective_thermal_expansion_model = user, in place of the porosity-weighted mixture '
                  'formula, and the mass kernel shall carry that value into the thermal storage term.'
  []
[]

