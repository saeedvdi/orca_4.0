    type = CSVDiff
    input = coulomb_return_mapping.i
    csvdiff = coulomb_return_mapping_out.csv
    rel_err = 1e-7
    abs_zero = 1e-30
    requirement = 'The cohesive-contact-friction law shall return the trial state exactly onto '
                  'the Coulomb yield surface, reproduce the roughness strength interpolation, '
                  'and never admit dilation work exceeding the (1 - dissipation_margin) '
                  'fraction of the frictional sliding work.'
